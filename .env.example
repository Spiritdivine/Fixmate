# Server
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/artisan_escrow_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-67890"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Payment Gateways (Paystack - Nigeria)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Platform Settings
ESCROW_FEE_PERCENT=5.00

# Monad Blockchain Settings
MONAD_RPC_URL="https://testnet-rpc.monad.xyz"
MONAD_CHAIN_ID=10143
DEPLOYER_PRIVATE_KEY="0x_your_private_key_here"
ESCROW_CONTRACT_ADDRESS="0x_deployed_contract_address_here"
ESCROW_ARBITER_ADDRESS="0x_arbiter_wallet_address_here"
ESCROW_FEE_RECIPIENT="0x_fee_collector_address_here"
